{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=4173 --host=127.0.0.1 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "node --import tsx --test \"src/**/*.test.ts\"",
    "validate:city": "tsx scripts/validate-city-layout.ts",
    "check": "node scripts/check.mjs",
    "smoke:regression": "node scripts/smoke-regression.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
